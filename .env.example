# Base de données (SQLite en local ; pour Supabase : provider "postgresql" + URL Postgres)
DATABASE_URL="file:./dev.db"
# Secret de session (32+ caractères aléatoires) : openssl rand -hex 32
AUTH_SECRET="change-me"
# Secret pour déclencher /api/cron/daily depuis un planificateur externe
CRON_SECRET="change-me-too"
# IA (optionnel) : analyse des produits par Claude
ANTHROPIC_API_KEY=""
# AliExpress Open Platform – programme Affiliés (optionnel, recherche fournisseur automatique)
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""
# URL publique de l'app (liens dans les notifications)
APP_URL="http://localhost:3000"
