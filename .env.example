# Base de données PostgreSQL (Supabase : Project Settings > Database > Connection string)
# Pooler "Transaction" (port 6543) :
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connexion directe ou "Session" (port 5432) :
DIRECT_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"
# Secret de session (32+ caractères aléatoires) : openssl rand -hex 32
AUTH_SECRET="change-me"
# Secret pour déclencher /api/cron/daily depuis un planificateur externe
CRON_SECRET="change-me-too"
# IA (optionnel) : analyse des produits par Claude
ANTHROPIC_API_KEY=""
# AliExpress Open Platform – programme Affiliés (optionnel, recherche fournisseur automatique)
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_TRACKING_ID=""
# URL publique de l'app (liens dans les notifications)
APP_URL="http://localhost:3000"
