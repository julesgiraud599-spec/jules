{
  "manifest_version": 3,
  "name": "Glacier – Recherche produits",
  "version": "1.0.0",
  "description": "Lit les pages Vinted, AliExpress et Temu que vous ouvrez, les relie à Claude Code (MCP local) et à votre tableau de bord Glacier.",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Glacier" },
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://*.vinted.fr/*", "https://*.vinted.be/*", "https://*.vinted.com/*",
    "https://*.aliexpress.com/*", "https://*.aliexpress.us/*",
    "https://*.temu.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "minimum_chrome_version": "116"
}
